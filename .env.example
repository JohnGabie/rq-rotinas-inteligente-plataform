# ===========================================
# Rotina Inteligente - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Database
POSTGRES_USER=rotina_user
POSTGRES_PASSWORD=rotina_password
POSTGRES_DB=rotina_inteligente_db

# Backend
SECRET_KEY=your-secret-key-here-min-32-chars
ENVIRONMENT=production

# Tuya Integration (optional)
TUYA_API_KEY=your_tuya_api_key
TUYA_API_SECRET=your_tuya_api_secret

# pgAdmin
PGADMIN_EMAIL=admin@rotina.com
PGADMIN_PASSWORD=admin

# Frontend (for local development without Docker)
VITE_API_URL=http://localhost:8000
VITE_USE_MOCK_API=false
